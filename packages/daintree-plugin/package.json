{
  "name": "daintree-plugin",
  "version": "0.2.0",
  "description": "CLI for building, validating, packaging, and installing Daintree plugins.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daintreehq/daintree.git",
    "directory": "packages/daintree-plugin"
  },
  "homepage": "https://github.com/daintreehq/daintree/tree/develop/docs/plugins",
  "bugs": {
    "url": "https://github.com/daintreehq/daintree/issues"
  },
  "keywords": [
    "daintree",
    "daintree-plugin",
    "cli",
    "scaffold"
  ],
  "type": "module",
  "bin": {
    "daintree-plugin": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "tsup"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "archiver": "^8.0.0",
    "commander": "^15.0.0",
    "esbuild": "^0.28.2",
    "execa": "^10.2.1",
    "globby": "^16.2.4",
    "semver": "^7.8.6",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "playwright-core": "~1.64.1"
  },
  "devDependencies": {
    "tsup": "^9.0.0"
  }
}
