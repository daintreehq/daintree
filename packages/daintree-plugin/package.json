{
  "name": "daintree-plugin",
  "version": "0.1.0",
  "description": "CLI for building, validating, packaging, and installing Daintree plugins.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "daintree-plugin": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "tsup"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "archiver": "^8.0.0",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "globby": "^14.1.0",
    "semver": "^7.8.0",
    "yauzl": "^3.4.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
