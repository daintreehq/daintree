{
  "name": "@daintreehq/svelte-source-model",
  "version": "0.1.0",
  "private": true,
  "description": "Svelte 5 source semantics for the SvelteKit Site Builder: resolve a rendered node's dev-runtime location to an AST node, and apply deterministic, source-preserving edits.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "tsup"
  },
  "dependencies": {
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
