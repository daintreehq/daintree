{
  "name": "@daintreehq/plugin-sdk",
  "version": "0.1.0",
  "description": "Public type surface for Daintree plugins — manifest, host API, activation contract, and forge/file-decoration provider types.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js",
      "default": "./dist/files.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "tsup"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.2.1",
    "tsup": "^8.5.0",
    "zod": "^4.3.6"
  }
}
