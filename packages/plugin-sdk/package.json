{
  "name": "@daintreehq/plugin-sdk",
  "version": "0.1.0",
  "description": "Public surface for Daintree plugins \u2014 manifest, host API, activation contract, React hooks, file helpers, and the in-memory mock host for tests.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daintreehq/daintree.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/daintreehq/daintree/tree/develop/docs/plugins",
  "bugs": {
    "url": "https://github.com/daintreehq/daintree/issues"
  },
  "keywords": [
    "daintree",
    "daintree-plugin",
    "sdk",
    "types"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js",
      "default": "./dist/files.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./plugin-ui": {
      "types": "./plugin-ui.d.ts"
    }
  },
  "files": [
    "dist",
    "plugin-ui.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsup"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "zod": "^4.6.5"
  }
}
