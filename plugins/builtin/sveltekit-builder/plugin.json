{
  "name": "daintree.sveltekit-builder",
  "version": "0.1.0",
  "displayName": "Element Picker",
  "description": "Pick elements in your dev preview, whatever the framework, and ask your coding agent to change them. SvelteKit apps are traced to their source.",
  "tagline": "Point at your app. Ask your agent to change it.",
  "category": "workspace",
  "main": "main/index.js",
  "engines": {
    "daintree": ">=0.36.0"
  },
  "capabilities": ["fs:project-read"],
  "scopes": {
    "fs": {
      "allowedPaths": ["${project}", "${worktree}"]
    }
  },
  "contributes": {
    "commands": [
      {
        "id": "toggle-builder",
        "title": "Toggle Element Picker",
        "description": "Switch the Element Picker on or off in this worktree's dev preview, opening the preview if none is running.",
        "category": "Dev preview",
        "kind": "command",
        "danger": "safe",
        "keywords": [
          "element",
          "picker",
          "select",
          "svelte",
          "sveltekit",
          "inspect",
          "inspector",
          "preview",
          "agent"
        ],
        "requires": []
      }
    ],
    "previewTools": [
      {
        "id": "daintree.sveltekit-builder.builder",
        "title": "Element Picker",
        "iconId": "square-dashed-mouse-pointer",
        "guestAdapter": "daintree.sveltekit-builder.guest"
      }
    ],
    "guestAdapters": [
      {
        "id": "daintree.sveltekit-builder.guest",
        "entry": "renderer/guest/entry.ts"
      }
    ]
  }
}
