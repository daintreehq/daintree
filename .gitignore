# Dependencies
node_modules
node_modules/

# Build outputs
dist/
dist-electron/
dist-typecheck/
out/
release/
*.asar
stats.html

# Screenshot capture output (marketing reel + theme-review harness)
artifacts/

# Build resources - keep icons but ignore iconset
build/icon.iconset/

# IDE
.idea/
.vscode/
.antigravitycli/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS - macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# OS - Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# OS - Linux
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Signing keys (local only — NEVER commit)
keys/
.signing/

# Local build lock (concurrency guard for package:local)
.local-build.lock

# Environment
.env
.env.*
!.env.example

# Performance capture output
perf-metrics.ndjson

# Demo recording output
demo-output/

# Demo authoring project (daintreehq/demo-studio clone target)
demo/

# Cache
.cache/
*.tsbuildinfo
.eslintcache
.prettiercache
github-stats-cache.json

# Testing
coverage/
.nyc_output/
test-results/
test-results-mechanism/
playwright-report/
blob-report/
daintree-e2e-artifacts/

# Temp files
tmp/
temp/
*.tmp
*.temp
reports/

# Electron specific
*.dmg
*.snap
*.AppImage
*.deb
*.rpm
.daintree/daintree-remote
# Private plugin storage (#10556) — machine-owned plugin state, never tracked.
.daintree/plugin-storage/

# Native addon build outputs (electron-rebuild + node-gyp)
electron/native/*/build/
electron/native/*/bin/

# Planning docs (private)
planning/
.planning/
.tmp
*.tgz

# Claude Code: ignore the whole .claude/ folder (session markers, locks,
# scratch workflows, worktrees, etc.). Shared slash commands, skills and
# path-scoped rules are the exception — they're project assets we commit.
.claude/*
!.claude/commands/
!.claude/skills/
!.claude/rules/

# Claude scratch / working notes (private, ephemeral)
.claude-scratch/
.lessons-build/

# Unredacted raw captures left behind by pattern-discovery:redact-cast in-place mode
*.cast.bak

# Perf results history: ~5k lines rewritten per canonical run, and the filename
# carries a machine label. Local to whoever ran it.
scripts/perf/history/*.json

# Built Daintree Assistant engine binaries (scripts/build-assistant.mjs).
# Compiled from the vendor/daintree-assistant submodule at build time; never committed.
resources/assistant/

# Declaration source maps are always tsc emit, never hand-written — a stray `tsc -b`
# drops them (and their .d.ts) beside the source it compiled.
*.d.ts.map

# Screenshots, wherever a suite drops them. Regenerated on demand, never committed:
# they are large, they change with every theme tweak, and they are evidence for a
# person looking at them now rather than a fixture anything asserts on. The specs that
# PRODUCE them live in e2e/screenshots/ and are tracked — only the .png output is not.
e2e/screenshots/**/*.png
e2e/screenshots/local/
