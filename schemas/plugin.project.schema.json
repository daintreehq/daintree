{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/daintreehq/daintree/develop/schemas/plugin.project.schema.json",
  "title": "Daintree project plugin manifest",
  "description": "Manifest for a Daintree plugin committed into a project's .daintree/plugins/ directory. Such a plugin must declare \"scope\": \"project\", and eight contribution types available to installed plugins are refused here.\n\nGenerated from Daintree's own manifest schema — do not edit by hand.\n\nStructural rules only. These cross-field rules are enforced when the plugin loads and cannot be expressed here:\n- A view's id must equal the id of a declared panel, and a surface's viewId must name a declared view whose panel is not a PTY panel.\n- Under project scope, menuItems, agents, skills, recipes, fileDecorationProviders, processTools, mcpServers and forgeProviders are refused, and \"scope\": \"project\" is required.\n- The reserved daintree.* publisher namespace is accepted only for built-in plugins.\n- A command id may not collide with a built-in action id, and some built-in ids refuse plugin dispatch outright.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "authors": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "url": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "forge",
        "ai",
        "workspace",
        "other"
      ]
    },
    "main": {
      "type": "string"
    },
    "engines": {
      "type": "object",
      "properties": {
        "daintree": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "string",
      "const": "project"
    },
    "capabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "fs:project-read",
          "fs:project-write",
          "fs:user-data-read",
          "fs:user-data-write",
          "network:fetch",
          "agent:invoke",
          "agent:read",
          "agent:register",
          "agent:input",
          "git:read",
          "git:write",
          "clipboard:read",
          "clipboard:write",
          "shell:exec",
          "socket:connect"
        ]
      }
    },
    "scopes": {
      "type": "object",
      "properties": {
        "network": {
          "type": "object",
          "properties": {
            "allowedUrls": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "allowedUrls"
          ],
          "additionalProperties": false
        },
        "fs": {
          "type": "object",
          "properties": {
            "allowedPaths": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "allowedPaths"
          ],
          "additionalProperties": false
        },
        "socket": {
          "type": "object",
          "properties": {
            "allowedPaths": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          },
          "required": [
            "allowedPaths"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "activationEvents": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "const": "onStartupFinished"
      }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "panels": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z0-9._-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "iconId": {
                "type": "string",
                "minLength": 1
              },
              "color": {
                "type": "string",
                "minLength": 1
              },
              "hasPty": {
                "default": false,
                "type": "boolean"
              },
              "canRestart": {
                "default": false,
                "type": "boolean"
              },
              "canConvert": {
                "default": false,
                "type": "boolean"
              },
              "showInPalette": {
                "default": true,
                "type": "boolean"
              },
              "dockable": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "iconId",
              "color"
            ],
            "additionalProperties": false
          }
        },
        "toolbarButtons": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z0-9._-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "iconId": {
                "type": "string",
                "minLength": 1
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  },
                  {
                    "type": "number",
                    "const": 3
                  },
                  {
                    "type": "number",
                    "const": 4
                  },
                  {
                    "type": "number",
                    "const": 5
                  }
                ]
              }
            },
            "required": [
              "id",
              "label",
              "iconId",
              "actionId"
            ],
            "additionalProperties": false
          }
        },
        "menuItems": {
          "default": [],
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string",
                "enum": [
                  "terminal",
                  "file",
                  "view",
                  "help"
                ]
              },
              "accelerator": {
                "type": "string"
              },
              "when": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "actionId",
              "location"
            ],
            "additionalProperties": false
          }
        },
        "keybindings": {
          "default": [],
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "combo": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "enum": [
                  "global",
                  "portal",
                  "worktreeGrid",
                  "dev-preview"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "actionId",
              "combo"
            ],
            "additionalProperties": false
          }
        },
        "contextMenus": {
          "default": [],
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string",
                "enum": [
                  "worktree",
                  "terminal",
                  "file"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "actionId",
              "location",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "commands": {
          "default": [],
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z0-9._-]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "command",
                  "query"
                ]
              },
              "danger": {
                "type": "string",
                "enum": [
                  "safe",
                  "confirm"
                ]
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "inputSchema": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "fs:project-read",
                    "fs:project-write",
                    "fs:user-data-read",
                    "fs:user-data-write",
                    "network:fetch",
                    "agent:invoke",
                    "agent:read",
                    "agent:register",
                    "agent:input",
                    "git:read",
                    "git:write",
                    "clipboard:read",
                    "clipboard:write",
                    "shell:exec",
                    "socket:connect"
                  ]
                }
              }
            },
            "required": [
              "id",
              "title",
              "description",
              "category",
              "kind",
              "danger"
            ],
            "additionalProperties": false
          }
        },
        "views": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z0-9._-]+$"
              },
              "componentPath": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string",
                "const": "panel"
              },
              "iconId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "componentPath",
              "location"
            ],
            "additionalProperties": false
          }
        },
        "mcpServers": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z0-9._-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "name",
              "command"
            ],
            "additionalProperties": false
          }
        },
        "skills": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z0-9._-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "triggers": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "name",
              "path"
            ],
            "additionalProperties": false
          }
        },
        "forgeProviders": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z0-9._-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "matches": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "kind": {
                "type": "string",
                "enum": [
                  "local",
                  "network"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "credentialFields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-zA-Z0-9._-]+$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "placeholder": {
                      "type": "string"
                    },
                    "helpText": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "type"
                  ],
                  "additionalProperties": false
                }
              },
              "settingsScopeRef": {
                "type": "string",
                "minLength": 1
              },
              "viewRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "slots": {
                "type": "object",
                "properties": {
                  "settingsTab": {
                    "type": "string",
                    "minLength": 1
                  },
                  "icon": {
                    "type": "string",
                    "minLength": 1
                  },
                  "statsDropdown": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bulkCreateWorktreeDialog": {
                    "type": "string",
                    "minLength": 1
                  },
                  "issueSelector": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "name",
              "matches"
            ],
            "additionalProperties": false
          }
        },
        "fileDecorationProviders": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z0-9._-]+$"
              },
              "scopes": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "scopes"
            ],
            "additionalProperties": false
          }
        },
        "agents": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z0-9._-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "args": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 256
                }
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "iconId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "supportsContextInjection": {
                "default": false,
                "type": "boolean"
              },
              "detection": {
                "type": "object",
                "properties": {
                  "primaryPatterns": {
                    "minItems": 1,
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "fallbackPatterns": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "bootCompletePatterns": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "promptPatterns": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "promptHintPatterns": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "completionPatterns": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "scanLineCount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "promptScanLineCount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "debounceMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 600000
                  },
                  "promptFastPathMinQuietMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 600000
                  },
                  "primaryConfidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "fallbackConfidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "promptConfidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "completionConfidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "titleStatePatterns": {
                    "type": "object",
                    "properties": {
                      "working": {
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "waiting": {
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      }
                    },
                    "required": [
                      "working",
                      "waiting"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
